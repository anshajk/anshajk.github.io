---
import SectionHeader from './SectionHeader.astro';
import { getLatestPosts } from '../lib/feed';

const posts = await getLatestPosts(4);

const formatter = new Intl.DateTimeFormat('en-GB', {
  month: 'short',
  year: 'numeric',
});
---

{
  posts.length > 0 && (
    <section class="section section--nested" id="writing">
      <div class="container">
        <SectionHeader
          eyebrow="Writing"
          title="The Compute Blog"
          lede="I run experiments and write up how modern AI systems actually work — agent tooling, evaluation, retrieval, and the engineering underneath. Latest posts, pulled straight from the feed."
        />

        <ul class="writing">
          {posts.map((post) => (
            <li class="writing__item">
              <a class="writing__link" href={post.url} rel="noopener">
                <time class="writing__date" datetime={post.date.toISOString()}>
                  {formatter.format(post.date)}
                </time>
                <span class="writing__body">
                  <span class="serif writing__title">{post.title}</span>
                  {post.summary && (
                    <span class="writing__summary">{post.summary}</span>
                  )}
                </span>
                <span class="writing__arrow" aria-hidden="true">
                  ↗
                </span>
              </a>
            </li>
          ))}
        </ul>

        <a class="writing__all" href="https://compute.anshaj.dev" rel="noopener">
          Read every post
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
  )
}

<style>
  .writing {
    list-style: none;
    border-top: 1px solid var(--color-chalk);
  }

  .writing__item {
    border-bottom: 1px solid var(--color-chalk);
  }

  .writing__link {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--spacing-8) var(--spacing-24);
    align-items: baseline;
    padding-block: var(--spacing-24);
    text-decoration: none;
    color: inherit;
  }

  @media (min-width: 48rem) {
    .writing__link {
      grid-template-columns: 7rem 1fr auto;
    }
  }

  .writing__date {
    font-size: var(--text-small);
    font-weight: var(--weight-medium);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--color-ashen);
    white-space: nowrap;
  }

  .writing__body {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  /*
   * Below 48rem the row collapses to two lines: date and arrow share the
   * first, the title and summary span the second. Placement is scoped to the
   * narrow breakpoint so the desktop grid needs no counter-overrides.
   */
  @media (max-width: 47.9375rem) {
    .writing__date {
      grid-column: 1;
      grid-row: 1;
    }

    .writing__arrow {
      grid-column: 2;
      grid-row: 1;
      justify-self: end;
    }

    .writing__body {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }

  .writing__title {
    font-size: 1.125rem;
    line-height: var(--leading-heading-sm);
    color: var(--color-carbon-ink);
  }

  .writing__summary {
    font-size: var(--text-body);
    line-height: 1.6;
    color: var(--color-ashen);
  }

  .writing__arrow {
    font-size: var(--text-body);
    color: var(--color-pebble);
    transition: transform var(--transition), color var(--transition);
  }

  .writing__link:hover .writing__title {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .writing__link:hover .writing__arrow {
    color: var(--color-carbon-ink);
    transform: translate(2px, -2px);
  }

  .writing__all {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-top: var(--spacing-24);
    font-size: var(--text-body);
    font-weight: var(--weight-medium);
    color: var(--color-carbon-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
