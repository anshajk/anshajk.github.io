---
import SectionHeader from './SectionHeader.astro';
import { getLatestPosts } from '../lib/feed';

interface Props {
  /** Show up to 20 feed entries on the writing page, or four on the homepage. */
  full?: boolean;
}

const { full = false } = Astro.props;
const posts = await getLatestPosts(full ? 20 : 4);
const sectionId = full ? 'recent-posts' : 'writing';

const formatter = new Intl.DateTimeFormat('en-GB', {
  day: full ? 'numeric' : undefined,
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<section
  class:list={['section', { 'section--nested': !full }]}
  id={sectionId}
  aria-labelledby={`${sectionId}-title`}
>
  <div class="container">
    <SectionHeader
      eyebrow={full ? 'From the feed' : 'Writing'}
      id={`${sectionId}-title`}
      title={full ? 'Recent posts' : 'The Compute Blog'}
      lede={
        full
          ? 'Up to 20 recent entries from the blog’s RSS feed, refreshed when this site is built. For older posts and anything published since, visit the full blog.'
          : 'I run experiments and write up how modern AI systems actually work — agent tooling, evaluation, retrieval, and the engineering underneath. Explore a curated starting point and recent posts.'
      }
    />

    {
      posts.length > 0 ? (
        <ul class="writing">
          {posts.map((post) => (
            <li class="writing__item">
              <a class="writing__link" href={post.url} rel="noopener">
                <time class="writing__date" datetime={post.date.toISOString()}>
                  {formatter.format(post.date)}
                </time>
                <span class="writing__body">
                  <span class="serif writing__title">{post.title}</span>
                  {post.summary && (
                    <span class="writing__summary">{post.summary}</span>
                  )}
                </span>
                <span class="writing__arrow" aria-hidden="true">
                  ↗
                </span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="writing__fallback prose">
          Recent posts are unavailable here right now.
          {full
            ? ' The Start here collection above is still ready to read, and all posts are available on the blog.'
            : ' Explore the Start here collection on the writing page, or visit the blog directly.'}
        </p>
      )
    }

    <div class="writing__actions">
      {
        !full && (
          <a class="writing__all" href="/writing/">
            Explore writing
            <span aria-hidden="true">→</span>
          </a>
        )
      }
      <a class="writing__all" href="https://compute.anshaj.dev" rel="noopener">
        Visit the full blog
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</section>

<style>
  .writing {
    list-style: none;
    border-top: 1px solid var(--color-chalk);
  }

  .writing__item {
    border-bottom: 1px solid var(--color-chalk);
  }

  .writing__link {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--spacing-8) var(--spacing-24);
    align-items: baseline;
    padding-block: var(--spacing-24);
    text-decoration: none;
    color: inherit;
  }

  @media (min-width: 48rem) {
    .writing__link {
      grid-template-columns: 7rem 1fr auto;
    }
  }

  .writing__date {
    font-size: var(--text-small);
    font-weight: var(--weight-medium);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--color-ashen);
    white-space: nowrap;
  }

  .writing__body {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  /*
   * Below 48rem the row collapses to two lines: date and arrow share the
   * first, the title and summary span the second. Placement is scoped to the
   * narrow breakpoint so the desktop grid needs no counter-overrides.
   */
  @media (max-width: 47.9375rem) {
    .writing__date {
      grid-column: 1;
      grid-row: 1;
    }

    .writing__arrow {
      grid-column: 2;
      grid-row: 1;
      justify-self: end;
    }

    .writing__body {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }

  .writing__title {
    font-size: 1.125rem;
    line-height: var(--leading-heading-sm);
    color: var(--color-carbon-ink);
  }

  .writing__summary {
    font-size: var(--text-body);
    line-height: 1.6;
    color: var(--color-ashen);
  }

  .writing__arrow {
    font-size: var(--text-body);
    color: var(--color-ashen);
    transition: transform var(--transition), color var(--transition);
  }

  .writing__link:hover .writing__title {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .writing__link:hover .writing__arrow {
    color: var(--color-carbon-ink);
    transform: translate(2px, -2px);
  }

  .writing__all {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: var(--text-body);
    font-weight: var(--weight-medium);
    color: var(--color-carbon-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .writing__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-16) var(--spacing-24);
    margin-top: var(--spacing-24);
  }
</style>
