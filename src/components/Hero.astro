---
import { site, socials } from '../data/site';
---

<section class="hero">
  <div class="container hero__inner">
    <p class="eyebrow">
      {site.role} · {site.company}
    </p>

    <h1 class="serif hero__title">
      {site.tagline}
    </h1>

    <p class="hero__subtitle">
      I'm {site.name}, a {site.role} at {site.company}. I design and build
      production AI agents and cloud data platforms for supply-chain operations,
      combining retrieval and tool integration with multi-agent orchestration,
      evaluation, and safety guardrails.
    </p>

    <div class="hero__actions">
      <a class="button button--primary" href="#work">See selected work</a>
      <a class="button button--ghost" href="/writing/">
        Explore the writing
      </a>
    </div>

    <ul class="hero__socials">
      {
        socials.map((item) => (
          <li>
            <a class="hero__social" href={item.href} rel="me noopener">
              {item.label}
              <span aria-hidden="true">↗</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .hero {
    padding-block: var(--spacing-80) var(--spacing-64);
    border-bottom: 1px solid var(--color-chalk);
  }

  @media (min-width: 48rem) {
    .hero {
      padding-block: var(--spacing-96) var(--spacing-80);
    }
  }

  .hero__inner {
    display: grid;
    gap: var(--spacing-24);
    max-width: 62rem;
  }

  .hero__title {
    font-size: clamp(2rem, 1.35rem + 3.1vw, 3.5rem);
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: var(--color-carbon-ink);
    max-width: 20ch;
  }

  .hero__subtitle {
    max-width: 58ch;
    font-size: 1.0625rem;
    color: var(--color-graphite);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-8);
    margin-top: var(--spacing-8);
  }

  .hero__socials {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-8) var(--spacing-24);
    margin-top: var(--spacing-16);
    list-style: none;
  }

  .hero__social {
    display: inline-flex;
    align-items: baseline;
    gap: 0.3rem;
    font-size: var(--text-body);
    color: var(--color-ashen);
    text-decoration: none;
  }

  .hero__social:hover {
    color: var(--color-carbon-ink);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .hero__social span {
    font-size: 0.75em;
  }
</style>
