---
import { getCollection } from 'astro:content';

const highlights = (await getCollection('highlights')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<section class="highlights" aria-label="Selected outcomes">
  <div class="container">
    <ul class="highlights__grid">
      {
        highlights.map((item) => (
          <li class="highlights__item">
            <p class="highlights__value">{item.data.value}</p>
            <p class="highlights__label">{item.data.label}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .highlights {
    background-color: var(--surface-nested);
    padding-block: var(--spacing-40);
  }

  .highlights__grid {
    display: grid;
    gap: var(--spacing-32);
    list-style: none;
  }

  @media (min-width: 36rem) {
    .highlights__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 62rem) {
    .highlights__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--spacing-24);
    }
  }

  .highlights__item {
    display: grid;
    gap: 0.375rem;
    padding-left: var(--spacing-16);
    border-left: 2px solid var(--color-clay);
  }

  .highlights__value {
    font-family: var(--font-serif);
    font-size: var(--text-heading-sm);
    line-height: var(--leading-heading-sm);
    color: var(--color-carbon-ink);
  }

  .highlights__label {
    font-size: var(--text-body);
    line-height: 1.5;
    color: var(--color-ashen);
    text-wrap: pretty;
  }
</style>
