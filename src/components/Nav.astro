---
import { nav, site } from '../data/site';

const path = Astro.url.pathname;
---

<header class="site-nav">
  <div class="container site-nav__inner">
    <a class="site-nav__brand" href="/">
      {site.shortName}<span class="site-nav__mark" aria-hidden="true">.</span>
    </a>
    <nav aria-label="Primary">
      <ul class="site-nav__list">
        {
          nav.map((item) => (
            <li>
              <a
                class="site-nav__link"
                href={item.href}
                aria-current={item.href === path ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 20;
    background-color: color-mix(
      in srgb,
      var(--color-bone-parchment) 88%,
      transparent
    );
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-chalk);
  }

  .site-nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-16);
    min-height: 60px;
    flex-wrap: wrap;
    padding-block: var(--spacing-8);
  }

  .site-nav__brand {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    color: var(--color-carbon-ink);
    text-decoration: none;
    letter-spacing: -0.01em;
  }

  .site-nav__mark {
    color: var(--color-clay);
  }

  .site-nav__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.125rem;
    list-style: none;
  }

  .site-nav__link {
    display: inline-block;
    padding: var(--spacing-8) 0.75rem;
    border-radius: var(--radius-nav);
    color: var(--color-graphite);
    font-size: 0.9375rem;
    font-weight: var(--weight-medium);
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--transition), background-color var(--transition);
  }

  .site-nav__link:hover,
  .site-nav__link[aria-current='page'] {
    color: var(--color-carbon-ink);
    background-color: var(--color-soft-stone);
  }

  @media (max-width: 34rem) {
    .site-nav__inner {
      justify-content: center;
    }

    .site-nav__list {
      justify-content: center;
    }

    .site-nav__link {
      padding-inline: 0.5rem;
      font-size: var(--text-body);
    }
  }
</style>
