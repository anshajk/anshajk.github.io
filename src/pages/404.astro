---
import Base from '../layouts/Base.astro';
---

<Base
  pageTitle="Page not found"
  description="That page doesn't exist on anshaj.dev."
>
  <section class="section">
    <div class="container notfound">
      <p class="eyebrow">404</p>
      <h1 class="serif notfound__title">This page doesn't exist.</h1>
      <p class="notfound__text">
        The link may be out of date — the site was rebuilt in 2026 and some old
        URLs went away.
      </p>
      <a class="button button--primary" href="/">Back to the homepage</a>
    </div>
  </section>
</Base>

<style>
  .notfound {
    display: grid;
    justify-items: start;
    gap: var(--spacing-16);
    padding-block: var(--spacing-64);
  }

  .notfound__title {
    font-size: var(--text-heading);
    line-height: var(--leading-heading);
    letter-spacing: -0.015em;
  }

  .notfound__text {
    max-width: 48ch;
    color: var(--color-ashen);
  }
</style>
